rules_version = '2';
// Reglas de seguridad de Comic Shop · Punto de Venta.
// Copia TODO este archivo en Firebase → Firestore Database → Reglas → Publicar (ver GUIA.md).
// Repiten en el servidor los permisos de la app (especificación §4 y §6): aunque alguien
// modifique la app, la vendedora no puede leer costos ni cambiar precios, y nadie puede
// borrar o reescribir una venta.
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() { return request.auth != null; }
    function uPath() { return /databases/$(database)/documents/usuarios/$(request.auth.uid); }
    function me() { return get(uPath()).data; }
    function activo() { return signed() && exists(uPath()) && me().activo == true; }
    function esAdmin() { return activo() && me().rol == 'admin'; }
    // Modo prueba: el administrador crea y borra ejemplos marcados con demo:true (nunca toca datos reales).
    function ejemploNuevo() { return esAdmin() && request.resource.data.demo == true; }
    function ejemploExistente() { return esAdmin() && resource.data.demo == true; }
    function esGestion() { return activo() && (me().rol == 'admin' || me().rol == 'encargada'); }
    function yo() { return me().usuario; }
    function estadoPath() { return /databases/$(database)/documents/sistema/estado; }
    function sinIniciar() { return !exists(estadoPath()); }
    function seIniciaAhora() { return sinIniciar() && existsAfter(estadoPath()); }
    function soloCambian(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    function contadorVentas() { return /databases/$(database)/documents/contadores/ventas; }
    function eventoPath(id) { return /databases/$(database)/documents/eventos/$(id); }
    function ventaPath(id) { return /databases/$(database)/documents/ventas/$(id); }
    function apartadoPath(id) { return /databases/$(database)/documents/apartados/$(id); }
    function cobroPath(id) { return /databases/$(database)/documents/usuarios/$(request.auth.uid)/operacionesCobro/$(id); }
    function numeracionPropia(id) {
      let contador = getAfter(contadorVentas()).data;
      let previo = exists(contadorVentas()) ? get(contadorVentas()).data.n : 0;
      return activo() && resource.data.uid == request.auth.uid && resource.data.usuario == yo()
        && contador.ventaId == id && contador.numero == request.resource.data.numero && contador.n == previo + 1;
    }
    function operacionNueva(ruta, estado) {
      let operacion = getAfter(ruta).data;
      return !exists(ruta) && operacion.uid == request.auth.uid
        && operacion.usuario == yo() && operacion.estado == estado;
    }
    function operacionRevertida(ruta, anterior, nuevo) {
      return get(ruta).data.estado == anterior && getAfter(ruta).data.estado == nuevo;
    }
    function motivoValido(mov) {
      return (esAdmin() && mov.motivo in ['ajuste', 'importación', 'sincronización'] && mov.ref == null)
        || (mov.ref is string && mov.ref.size() > 0 && (
          (mov.cantidad < 0 && (
            (mov.motivo == 'venta' && operacionNueva(ventaPath(mov.ref), 'ok'))
            || (mov.motivo == 'apartado' && operacionNueva(apartadoPath(mov.ref), 'pendiente'))))
          || (mov.cantidad > 0 && esGestion() && (
            (mov.motivo == 'anulación' && operacionRevertida(ventaPath(mov.ref), 'ok', 'anulada'))
            || (mov.motivo == 'cancelación' && operacionRevertida(apartadoPath(mov.ref), 'pendiente', 'cancelado'))))));
    }
    function movimientoValido(mov) {
      return mov.usuario == yo() && mov.sku is string && mov.sku.size() > 0
        && mov.cantidad is int && mov.cantidad != 0 && motivoValido(mov);
    }
    function cambioConMovimiento(sku) {
      let ruta = /databases/$(database)/documents/movimientos/$(request.resource.data.ultimoMov);
      let mov = getAfter(ruta).data;
      let existencia = request.resource.data.existencia;
      return existencia is int && mov.sku == sku && mov.cantidad == existencia - resource.data.existencia
        && movimientoValido(mov)
        && (mov.motivo in ['venta', 'apartado'] ? existencia >= 0
          : (mov.motivo in ['anulación', 'cancelación'] || (mov.motivo == 'ajuste' && !exists(ruta))));
    }
    function cajaAbiertaPath(u) { return /databases/$(database)/documents/cajaAbierta/$(u); }

    // Estado del sistema: público (la pantalla de entrada necesita saber si ya hay administrador).
    match /sistema/estado {
      allow read: if true;
      allow create: if signed() && sinIniciar() && getAfter(uPath()).data.rol == 'admin';
      allow update, delete: if esAdmin();
    }

    // Usuario → correo interno para entrar (no contiene datos del negocio).
    match /logins/{usuario} {
      allow read: if true;
      allow create: if esAdmin() || (seIniciaAhora() && request.resource.data.uid == request.auth.uid);
      allow update, delete: if esAdmin();
    }

    // Perfiles: cada quien lee el suyo (también si está desactivado, para que la app lo sepa).
    match /usuarios/{uid} {
      allow read: if signed() && (request.auth.uid == uid || activo());
      allow create: if esAdmin() || (request.auth.uid == uid && seIniciaAhora() && request.resource.data.rol == 'admin');
      allow update, delete: if esAdmin();
    }

    // Productos: todos los leen. Solo el admin los crea o cambia; los demás solo la existencia (ventas, apartados, anulaciones).
    match /productos/{sku} {
      allow read: if activo();
      allow create, delete: if esAdmin();
      // Ventas y reservas llevan su movimiento aun para administración. Si el decremento
      // deja saldo negativo, se rechaza el lote completo. Se preservan los ajustes e importaciones de gestión.
      allow update: if (esAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ultimoMov']))
        || (activo() && soloCambian(['existencia', 'ultimoMov'])
          && request.resource.data.ultimoMov is string && request.resource.data.ultimoMov.size() > 0
          && request.resource.data.ultimoMov != resource.data.get('ultimoMov', null)
          && cambioConMovimiento(sku));
    }

    // Costos: solo administrador y encargada los ven; solo el administrador los cambia (importación).
    match /costos/{sku} {
      allow read: if esGestion();
      allow write: if esAdmin();
    }

    // Costo congelado de cada venta: se crea una vez y no se edita.
    match /costosVenta/{id} {
      allow read: if esGestion();
      allow create: if esGestion();
      allow update: if false;
      allow delete: if esAdmin() && id.matches('demo-.*');
    }

    // Ventas: solo se crean (nunca se reescriben ni se borran). Gestión puede anular o poner el número.
    match /ventas/{id} {
      allow create: if ejemploNuevo();
      allow delete: if ejemploExistente();
      allow get: if esGestion() || (activo() && (resource == null || resource.data.usuario == yo()));
      allow list: if esGestion() || (activo() && resource.data.usuario == yo());
      allow create: if activo()
        && request.resource.data.usuario == yo()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'ok'
        && get(/databases/$(database)/documents/cajas/$(request.resource.data.cajaId)).data.usuario == yo();
      allow update: if
        (esGestion() && resource.data.estado == 'ok' && request.resource.data.estado == 'anulada'
          && request.resource.data.anulacion.por == yo() && soloCambian(['estado', 'anulacion']))
        || (resource.data.numero == null && request.resource.data.numero is string
          && request.resource.data.numero.matches('V-[0-9]{4,}') && soloCambian(['numero'])
          && (esGestion() || numeracionPropia(id)));
      allow delete: if false;
    }

    // Contador para numerar ventas (V-0001…).
    match /contadores/{id} {
      allow read: if activo();
      allow create: if activo() && request.resource.data.n == 1;
      allow update: if activo() && request.resource.data.n == resource.data.n + 1;
    }

    // Apartados: cualquiera del equipo crea, abona y completa; solo gestión cancela. Solo se modifican mientras están pendientes.
    match /apartados/{id} {
      allow create: if ejemploNuevo();
      allow delete: if ejemploExistente();
      allow read: if activo();
      allow create: if activo() && request.resource.data.usuario == yo() && request.resource.data.estado == 'pendiente';
      allow update: if activo() && resource.data.estado == 'pendiente' && (
          (soloCambian(['abonos', 'saldo', 'ultimoAbono']) && request.resource.data.abonos.hasAll(resource.data.abonos)
            && request.resource.data.abonos.size() > resource.data.abonos.size()
            && request.resource.data.saldo <= resource.data.saldo && request.resource.data.saldo >= 0
            && (request.resource.data.get('ultimoAbono', null) == resource.data.get('ultimoAbono', null)
              || abonoMarcado(id)))
          || (soloCambian(['estado', 'ventaId', 'saldo']) && request.resource.data.estado == 'completado'
            && getAfter(ventaPath(request.resource.data.ventaId)).data.desdeApartado == id
            && getAfter(ventaPath(request.resource.data.ventaId)).data.abonosPrevios == resource.data.total - resource.data.saldo)
          || (esGestion() && soloCambian(['estado', 'cancelacion']) && request.resource.data.estado == 'cancelado'
            && request.resource.data.cancelacion.por == yo()));
      allow delete: if false;
    }

    function abonoMarcado(apartadoId) {
      let ruta = cobroPath(request.resource.data.ultimoAbono);
      let marca = getAfter(ruta).data;
      return !exists(ruta) && marca.que == 'abono' && marca.apartadoId == apartadoId
        && marca.estadoSync == 'confirmada_servidor';
    }

    // Marcas inmutables del resultado, en la misma escritura que el cobro o el conflicto.
    function documentoCobrado(p, id) {
      return (p.que in ['venta', 'completar'] && getAfter(ventaPath(p.refId)).data.uid == request.auth.uid)
        || (p.que == 'apartado' && getAfter(apartadoPath(p.refId)).data.uid == request.auth.uid)
        || (p.que == 'abono' && getAfter(apartadoPath(p.apartadoId)).data.ultimoAbono == id);
    }
    match /usuarios/{uid}/operacionesCobro/{id} {
      allow get: if activo() && uid == request.auth.uid;
      allow create: if activo() && uid == request.auth.uid
        && request.resource.data.que in ['venta', 'apartado', 'abono', 'completar']
        && id == request.resource.data.que + ':' + request.resource.data.refId
        && request.resource.data.orden is int && request.resource.data.orden > 0
        && request.resource.data.dispositivo is string && request.resource.data.fecha is string
        && (request.resource.data.estadoSync == 'confirmada_servidor' && documentoCobrado(request.resource.data, id)
          || request.resource.data.estadoSync == 'rechazada_conflicto'
            && getAfter(/databases/$(database)/documents/conflictos/$(request.resource.data.conflictoId)).data.uid == uid);
      allow list, update, delete: if false;
    }

    // Cajas: cada quien la suya. Gestión puede agregar movimientos (devoluciones) a una caja abierta ajena; el admin reabre.
    match /cajas/{id} {
      // v2.31 · Modo prueba: el administrador crea y borra las cajas de la vendedora simulada (demo:true).
      allow create: if ejemploNuevo();
      allow delete: if ejemploExistente();
      allow read: if esGestion() || (activo() && resource.data.usuario == yo());
      allow create: if activo() && request.resource.data.usuario == yo() && request.resource.data.estado == 'abierta'
        && getAfter(cajaAbiertaPath(yo())).data.cajaId == id
        && (request.resource.data.get('tipo', 'tienda') != 'personal' || esGestion());
      allow update: if
          (activo() && resource.data.usuario == yo() && resource.data.estado == 'abierta'
            && ((soloCambian(['movimientos']) && request.resource.data.movimientos.hasAll(resource.data.movimientos)) || (soloCambian(['estado', 'cierre']) && request.resource.data.estado == 'cerrada' && !existsAfter(cajaAbiertaPath(yo())))))
          || (esGestion() && resource.data.estado == 'abierta' && soloCambian(['movimientos']) && request.resource.data.movimientos.hasAll(resource.data.movimientos))
          || (esAdmin() && resource.data.estado == 'cerrada' && request.resource.data.estado == 'abierta' && soloCambian(['estado', 'reaperturas']))
          // Cierre automático de medianoche hecho por la app de la encargada o del administrador
          || (esGestion() && resource.data.estado == 'abierta' && soloCambian(['estado', 'cierre']) && request.resource.data.estado == 'cerrada'
              && request.resource.data.cierre.automatico == true && !existsAfter(cajaAbiertaPath(resource.data.usuario)))
          // Arqueo de una caja que se cerró sola: la dueña de la caja o gestión, una sola vez
          || (((activo() && resource.data.usuario == yo()) || esGestion()) && resource.data.estado == 'cerrada'
              && resource.data.cierre.porArquear == true && soloCambian(['cierre'])
              && request.resource.data.cierre.porArquear == false && request.resource.data.cierre.automatico == true);
      allow delete: if false;
    }

    // Marca de "caja abierta" por usuario: solo se puede crear si no existe, así nadie tiene dos cajas abiertas.
    match /cajaAbierta/{usuario} {
      allow read: if activo();
      allow create: if (activo() && usuario == yo()) || esAdmin();
      allow delete: if (activo() && usuario == yo()) || esGestion();
      allow update: if false;
    }

    // Historial de cambios de existencia: se crea con cada venta o ajuste; nadie lo edita.
    match /movimientos/{id} {
      allow read: if esGestion();
      allow create: if activo() && movimientoValido(request.resource.data)
        && (!request.resource.data.keys().hasAny(['importacionId', 'loteImportacion'])
          || movimientoDirigidoPorImportacion(id, request.resource.data));
      allow update, delete: if false;
    }

    // v2.26 · Conflictos de sincronización (ventas, apartados o abonos que el servidor rechazó, o que dejaron
    // existencia negativa): los registra quien los tuvo; gestión los ve y los marca como revisados. Nadie los borra.
    match /conflictos/{id} {
      allow read: if esGestion() || (activo() && resource.data.usuario == yo());
      allow create: if activo() && request.resource.data.usuario == yo() && request.resource.data.uid == request.auth.uid
        && request.resource.data.estado == 'pendiente';
      allow update: if esGestion() && resource.data.estado == 'pendiente' && soloCambian(['estado', 'revision'])
        && request.resource.data.estado == 'revisado' && request.resource.data.revision.por == yo();
      allow delete: if false;
    }

    // v2.27: los clientes no se borran, y cada alta o cambio va con su evento en el registro de actividad.
    function altaClienteConEvento(telefono) {
      let ruta = eventoPath(request.resource.data.ultimoEvento);
      let ev = getAfter(ruta).data;
      return !exists(ruta) && ev.tipo == 'cliente.guardado' && ev.ref.id == telefono;
    }
    match /clientes/{telefono} {
      allow read: if activo();
      allow create, update: if ejemploNuevo() || (activo() && altaClienteConEvento(telefono));
      allow delete: if ejemploExistente();
    }

    function importacionPath(id) { return /databases/$(database)/documents/importaciones/$(id); }
    function loteImportacionPath(id, lote) { return /databases/$(database)/documents/importaciones/$(id)/lotes/$(lote); }
    function detalleImportacionPath(id, lote, sku) {
      return /databases/$(database)/documents/importaciones/$(id)/lotes/$(lote)/detalles/$(sku);
    }
    function movimientoDirigidoPorImportacion(id, mov) {
      let detalle = getAfter(detalleImportacionPath(mov.importacionId, mov.loteImportacion, mov.sku)).data;
      return esAdmin() && mov.motivo in ['importación', 'sincronización']
        && detalle.movimientoId == id && detalle.uid == request.auth.uid && detalle.en == request.time
        && mov.cantidad == detalle.existenciaDespues - (detalle.existenciaAntes == null ? 0 : detalle.existenciaAntes);
    }
    function actorImportacion(d) {
      return d.uid == request.auth.uid && d.usuario == yo() && d.en == request.time
        && d.dispositivo is string && d.dispositivo.size() <= 120;
    }
    function avanceImportacion(id, d) {
      let ruta = loteImportacionPath(id, d.lote);
      let lote = getAfter(ruta).data;
      return id.matches('[0-9a-f]{64}') && actorImportacion(d)
        && d.keys().hasOnly(['uid', 'usuario', 'en', 'dispositivo', 'total', 'siguiente', 'lote'])
        && d.total is int && d.siguiente is int && d.siguiente > 0 && d.siguiente <= d.total
        && !exists(ruta) && lote.indice == d.siguiente - 1 && lote.uid == d.uid;
    }
    function detalleEnLote(id, lote, sku) {
      let detalle = getAfter(detalleImportacionPath(id, lote, sku)).data;
      return sku is string && detalle.sku == sku && detalle.en == request.time && detalle.uid == request.auth.uid;
    }
    function loteImportacionValido(id, lote, d) {
      let cabeza = getAfter(importacionPath(id)).data;
      return actorImportacion(d) && d.keys().hasOnly(['uid', 'usuario', 'en', 'dispositivo', 'indice', 'skus'])
        && cabeza.lote == lote && cabeza.siguiente == d.indice + 1 && cabeza.en == request.time
        && d.skus is list && d.skus.size() in [1, 2] && detalleEnLote(id, lote, d.skus[0])
        && (d.skus.size() == 1 || (d.skus[0] != d.skus[1] && detalleEnLote(id, lote, d.skus[1])));
    }
    function detalleImportacionValido(id, lote, sku, d) {
      let rutaLote = loteImportacionPath(id, lote);
      let prod = /databases/$(database)/documents/productos/$(sku);
      let costo = /databases/$(database)/documents/costos/$(sku);
      return actorImportacion(d) && d.keys().hasOnly([
          'uid', 'usuario', 'en', 'dispositivo', 'sku', 'productoAntes', 'productoDespues',
          'existenciaAntes', 'existenciaDespues', 'costoAntes', 'costoDespues', 'movimientoId'])
        && d.sku == sku && !exists(rutaLote) && sku in getAfter(rutaLote).data.skus
        && d.productoAntes == (exists(prod) ? get(prod).data : null)
        && d.productoDespues == getAfter(prod).data
        && d.existenciaAntes == (d.productoAntes == null ? null : d.productoAntes.existencia)
        && d.existenciaDespues == d.productoDespues.existencia
        && d.costoAntes == (exists(costo) ? get(costo).data.costo : null)
        && d.costoDespues == (existsAfter(costo) ? getAfter(costo).data.costo : null);
    }
    function importacionTerminada(ev) {
      let ruta = importacionPath(ev.ref.id);
      let despues = getAfter(ruta).data;
      return esAdmin() && ev.ref.col == 'importaciones' && despues.siguiente == despues.total
        && despues.en == request.time && despues.uid == request.auth.uid
        && (!exists(ruta) || get(ruta).data.siguiente < despues.total);
    }
    match /importaciones/{id} {
      allow read: if esGestion();
      allow create: if esAdmin() && request.resource.data.siguiente == 1
        && avanceImportacion(id, request.resource.data);
      allow update: if esAdmin() && resource.data.uid == request.auth.uid
        && soloCambian(['en', 'dispositivo', 'siguiente', 'lote'])
        && request.resource.data.siguiente == resource.data.siguiente + 1
        && avanceImportacion(id, request.resource.data);
      allow delete: if false;
      match /lotes/{lote} {
        allow read: if esGestion();
        allow create: if esAdmin() && loteImportacionValido(id, lote, request.resource.data);
        allow update, delete: if false;
        match /detalles/{sku} {
          allow read: if esGestion();
          allow create: if esAdmin() && detalleImportacionValido(id, lote, sku, request.resource.data);
          allow update, delete: if false;
        }
      }
    }

    function rutaEvento(ev) {
      return /databases/$(database)/documents/$(ev.ref.col)/$(ev.ref.id);
    }
    function eventoNuevo(ev, col, estado) {
      return ev.ref.col == col && operacionNueva(rutaEvento(ev), estado);
    }
    function transicionEvento(ev, col, anterior, nuevo, campo) {
      return ev.ref.col == col && operacionRevertida(rutaEvento(ev), anterior, nuevo)
        && getAfter(rutaEvento(ev)).data[campo].por == yo();
    }
    function eventoApartado(ev) {
      let ruta = rutaEvento(ev);
      let antes = get(ruta).data;
      let despues = getAfter(ruta).data;
      return ev.ref.col == 'apartados' && antes.estado == 'pendiente' && (
        (ev.tipo == 'apartado.abono' && despues.abonos.size() > antes.abonos.size()
          && despues.abonos[despues.abonos.size() - 1].usuario == yo())
        || (ev.tipo == 'apartado.completado' && despues.estado == 'completado'
          && despues.ventaId == ev.ref.venta && operacionNueva(ventaPath(ev.ref.venta), 'ok')));
    }
    function eventoCaja(ev) {
      let ruta = rutaEvento(ev);
      let antes = get(ruta).data;
      let despues = getAfter(ruta).data;
      return ev.ref.col == 'cajas' && (
        (ev.tipo in ['caja.entrada', 'caja.salida'] && despues.usuario == yo()
          && despues.movimientos.size() == antes.movimientos.size() + 1
          && despues.movimientos[antes.movimientos.size()].usuario == yo()
          && ev.tipo == 'caja.' + despues.movimientos[antes.movimientos.size()].tipo)
        || (ev.tipo == 'caja.cerrada' && antes.estado == 'abierta' && despues.estado == 'cerrada'
          && despues.usuario == yo() && !despues.cierre.get('automatico', false))
        || (ev.tipo == 'caja.cierre_automatico' && antes.estado == 'abierta' && despues.estado == 'cerrada'
          && despues.cierre.automatico == true && despues.cierre.por == yo())
        || (ev.tipo == 'caja.arqueada' && antes.cierre.porArquear == true
          && despues.cierre.porArquear == false && despues.cierre.arqueo.por == yo())
        || (ev.tipo == 'caja.reabierta' && esAdmin() && antes.estado == 'cerrada' && despues.estado == 'abierta'
          && despues.reaperturas[despues.reaperturas.size() - 1].por == yo()));
    }
    function eventoDescuento(ev) {
      let ruta = rutaEvento(ev);
      let despues = getAfter(ruta).data;
      return ev.ref.col == 'autorizaciones' && (
        (ev.tipo == 'descuento.pedido' && !exists(ruta) && despues.estado == 'pendiente'
          && despues.uid == request.auth.uid && despues.solicita == yo())
        || (esAdmin() && get(ruta).data.estado == 'pendiente' && despues.aprueba == yo()
          && ((ev.tipo == 'descuento.aprobado' && despues.estado == 'aprobada')
            || (ev.tipo == 'descuento.rechazado' && despues.estado == 'rechazada'))));
    }
    function eventoAjusteStock(ev) {
      let ruta = rutaEvento(ev);
      let despues = getAfter(ruta).data;
      let mov = /databases/$(database)/documents/movimientos/$(despues.ultimoMov);
      return ev.ref.col == 'productos' && esAdmin() && get(ruta).data.existencia != despues.existencia
        && !exists(mov) && getAfter(mov).data.motivo == 'ajuste'
        && getAfter(mov).data.usuario == yo();
    }
    function documentoCambiado(ruta) {
      return existsAfter(ruta) && (!exists(ruta) || get(ruta).data != getAfter(ruta).data);
    }
    function eventoCliente(ev) {
      let ruta = rutaEvento(ev);
      return ev.ref.col == 'clientes' && getAfter(ruta).data.ultimoEvento == ev.id
        && (!exists(ruta) || get(ruta).data.get('ultimoEvento', null) != ev.id);
    }
    function eventoUsuario(ev) {
      let ruta = rutaEvento(ev);
      return ev.ref.col == 'usuarios' && (
        (ev.tipo == 'usuario.eliminado' && esAdmin() && exists(ruta) && !existsAfter(ruta))
        || (ev.tipo == 'usuario.pin' && (esAdmin() || ev.ref.id == request.auth.uid))
        || (esAdmin() && documentoCambiado(ruta)));
    }
    function eventoVerificable(ev) {
      return (ev.tipo == 'venta.creada' && eventoNuevo(ev, 'ventas', 'ok'))
        || (ev.tipo == 'venta.anulada' && esGestion() && transicionEvento(ev, 'ventas', 'ok', 'anulada', 'anulacion'))
        || (ev.tipo == 'apartado.creado' && ev.ref.col == 'apartados' && !exists(rutaEvento(ev))
          && getAfter(rutaEvento(ev)).data.usuario == yo() && getAfter(rutaEvento(ev)).data.estado == 'pendiente')
        || (ev.tipo in ['apartado.abono', 'apartado.completado'] && eventoApartado(ev))
        || (ev.tipo == 'apartado.cancelado' && esGestion() && transicionEvento(ev, 'apartados', 'pendiente', 'cancelado', 'cancelacion'))
        || (ev.tipo == 'caja.abierta' && ev.ref.col == 'cajas' && !exists(rutaEvento(ev))
          && getAfter(rutaEvento(ev)).data.usuario == yo() && getAfter(rutaEvento(ev)).data.estado == 'abierta')
        || (ev.tipo in ['caja.entrada', 'caja.salida', 'caja.cerrada', 'caja.cierre_automatico', 'caja.arqueada', 'caja.reabierta'] && eventoCaja(ev))
        || (ev.tipo in ['descuento.pedido', 'descuento.aprobado', 'descuento.rechazado'] && eventoDescuento(ev))
        || (ev.tipo == 'inventario.ajuste' && eventoAjusteStock(ev))
        || (ev.tipo == 'inventario.importacion' && ev.ref != null && importacionTerminada(ev))
        || (ev.tipo == 'conflicto.registrado' && eventoNuevo(ev, 'conflictos', 'pendiente'))
        || (ev.tipo == 'conflicto.revisado' && esGestion() && transicionEvento(ev, 'conflictos', 'pendiente', 'revisado', 'revision'))
        || (ev.tipo == 'ajustes.cambiados' && esAdmin() && ev.ref.col == 'ajustes' && documentoCambiado(rutaEvento(ev)))
        || (ev.tipo == 'cliente.guardado' && eventoCliente(ev))
        || (ev.tipo == 'comisiones.pagadas' && esGestion() && ev.ref.col == 'comisiones' && !exists(rutaEvento(ev))
          && getAfter(rutaEvento(ev)).data.por == yo())
        || (ev.tipo in ['usuario.creado', 'usuario.pin', 'usuario.comision', 'usuario.perfil', 'usuario.eliminado',
              'usuario.activado', 'usuario.desactivado'] && eventoUsuario(ev));
    }
    // Informativos del cliente. Las versiones antiguas no incluyen una referencia que el servidor pueda atestiguar.
    function actividadInformativa(ev) {
      return (ev.tipo in ['sesion.entrada', 'sesion.salida'] && ev.ref == null)
        || (esAdmin() && ((ev.tipo in ['inventario.importacion', 'foto.subida'] && ev.ref == null)
          || (ev.tipo == 'oferta.cambiada' && ev.ref.col == 'productos' && ev.ref.grupo is string)));
    }

    match /eventos/{id} {
      allow read: if esGestion();
      allow create: if activo() && request.resource.data.id == id
        && request.resource.data.uid == request.auth.uid && request.resource.data.usuario == yo()
        && request.resource.data.rol == me().rol && request.resource.data.en == request.time
        && (eventoVerificable(request.resource.data) || actividadInformativa(request.resource.data));
      allow update, delete: if false;
    }

    match /autorizaciones/{id} {
      allow read: if esAdmin() || (activo() && resource.data.usuario == yo());
      allow create: if activo() && request.resource.data.uid == request.auth.uid
        && request.resource.data.usuario == yo() && request.resource.data.solicita == yo()
        && request.resource.data.estado == 'pendiente';
      allow update: if esAdmin() && resource.data.estado == 'pendiente'
        && soloCambian(['estado', 'aprueba', 'respondida'])
        && request.resource.data.estado in ['aprobada', 'rechazada'] && request.resource.data.aprueba == yo();
      allow delete: if false;
    }

    // Pagos de comisiones: solo gestión.
    match /comisiones/{id} {
      allow read, create: if esGestion();
      allow update: if false;
      allow delete: if ejemploExistente(); // v2.31: Modo prueba
    }

    // Ajustes (tasas, formas de pago, tramos, comisiones por defecto): todos leen, solo el admin cambia.
    match /ajustes/{doc} {
      allow read: if activo();
      allow write: if esAdmin();
    }
  }
}
